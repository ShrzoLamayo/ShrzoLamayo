# =================================
# ZONING COMPLIANCE SYSTEM - ENVIRONMENT VARIABLES
# =================================

# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL=postgresql://zoning_user:zoning_password@localhost:5432/zoning_db

# =================================
# CACHE CONFIGURATION
# =================================
REDIS_URL=redis://localhost:6379

# =================================
# AUTHENTICATION
# =================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# =================================
# FILE STORAGE (AWS S3)
# =================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=zoning-files

# =================================
# MAPPING & GIS SERVICES
# =================================

# Mapbox API (for frontend mapping and geocoding)
REACT_APP_MAPBOX_TOKEN=your_mapbox_access_token

# Google Elevation API (for elevation data)
GOOGLE_ELEVATION_API_KEY=your_google_elevation_api_key

# =================================
# FILE PROCESSING SERVICES
# =================================

# Autodesk Forge API (for DWG file processing and 3D conversion)
FORGE_CLIENT_ID=your_autodesk_forge_client_id
FORGE_CLIENT_SECRET=your_autodesk_forge_client_secret
FORGE_BUCKET_KEY=zoning-forge-bucket

# =================================
# APPLICATION CONFIGURATION
# =================================

# API URLs
REACT_APP_API_URL=http://localhost:3001

# Application Environment
NODE_ENV=development

# Server Port
PORT=3001

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=info

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# OPTIONAL: ADDITIONAL INTEGRATIONS
# =================================

# OpenWeather API (for weather-based analysis - future feature)
# OPENWEATHER_API_KEY=your_openweather_api_key

# NASA DEM API (for advanced elevation data - future feature)
# NASA_API_KEY=your_nasa_api_key

# =================================
# DEVELOPMENT SETTINGS
# =================================

# Enable detailed error logging in development
DEBUG_MODE=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =================================
# API KEY ACQUISITION LINKS
# =================================
# Mapbox: https://www.mapbox.com/
# Google Elevation: https://developers.google.com/maps/documentation/elevation/start
# Autodesk Forge: https://forge.autodesk.com/
# AWS S3: https://aws.amazon.com/s3/