# Database Configuration
DATABASE_URL=sqlite:///./building_plans.db

# For PostgreSQL with PostGIS (production)
# DATABASE_URL=postgresql://username:password@localhost/building_plans

# API Configuration
API_HOST=localhost
API_PORT=8000

# GIS Services
MAPBOX_TOKEN=your-mapbox-token-here

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_FOLDER=uploads

# External APIs (for production)
CMDA_API_ENDPOINT=https://api.cmda.gov.in
TNPCB_API_ENDPOINT=https://api.tnpcb.gov.in

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Development Settings
DEBUG=True
RELOAD=True